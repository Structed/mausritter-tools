@inherits LayoutComponentBase
@using MausritterTools.Core.Data
@using MausritterTools.Web.Services
@using Structed.Inkwell.Data
@implements IDisposable
@inject GameDataProvider DataProvider
@inject LocaleState Locale

@* The UI text is loaded once here and cascaded, so no component has to fetch it for itself and
   every one of them changes language at the same moment. *@

<CascadingValue Value="_text">
    @* A masthead puts the whole of the navigation ahead of the content, so there has to be a way
       past it. *@
    <a class="skip-link" href="#content">@_text.Nav.SkipToContent</a>

    <SiteHeader />

    <main id="content" class="content">
        @Body
    </main>
</CascadingValue>

@code {
    private UiText _text = new();

    protected override async Task OnInitializedAsync()
    {
        Locale.Changed += OnLanguageChanged;
        await LoadTextAsync();
    }

    private async Task LoadTextAsync()
    {
        try
        {
            _text = await DataProvider.GetTextAsync();
        }
        catch (GameDataException)
        {
            // Labels will be blank, which is bad, but the page still renders and the settlement
            // page shows the real error against the data file it failed on.
            _text = new UiText();
        }

        await Locale.ApplyToDocumentAsync(_text);
    }

    private async Task OnLanguageChanged()
    {
        await LoadTextAsync();
        StateHasChanged();
    }

    public void Dispose() => Locale.Changed -= OnLanguageChanged;
}
