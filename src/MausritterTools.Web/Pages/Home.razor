@page "/"
@using MausritterTools.Core.Data
@using MausritterTools.Web.Components

<PageTitle>@Text.App.Title</PageTitle>

<div class="settlement-tool">
    <h1>@Text.Home.Heading</h1>

    <p class="lead">@((MarkupString)Text.Home.LeadHtml)</p>

    <p>@((MarkupString)Text.Home.NoServerHtml)</p>

    <h2>@Text.Home.ToolsHeading</h2>

    <ul>
        <li>@((MarkupString)Text.Home.SettlementItemHtml)</li>
    </ul>

    <p><a href="about">@Text.Home.AboutLinkText</a>.</p>

    <LicenceFooter ShowHouseRuleNote="false" />
</div>

@code {
    [CascadingParameter]
    private UiText Text { get; set; } = new();
}
