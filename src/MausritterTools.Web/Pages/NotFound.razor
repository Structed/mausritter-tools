@page "/not-found"
@layout MainLayout
@using MausritterTools.Core.Data

<PageTitle>@Text.NotFound.Heading</PageTitle>

<h1>@Text.NotFound.Heading</h1>
<p>@Text.NotFound.Message</p>
<p><a href="">@Text.NotFound.BackLink</a></p>

@code {
    [CascadingParameter]
    private UiText Text { get; set; } = new();
}
