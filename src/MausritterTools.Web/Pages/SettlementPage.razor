@page "/settlement"
@using System.Text
@using MausritterTools.Core.Data
@using MausritterTools.Core.Generation
@using MausritterTools.Core.Mapping
@using MausritterTools.Core.Model
@using MausritterTools.Core.Randomness
@using MausritterTools.Core.Rendering
@using MausritterTools.Core.Serialization
@using MausritterTools.Web.Components
@using MausritterTools.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject GameDataProvider DataProvider
@inject BrowserInterop Browser
@inject LocaleState Languages
@inject NavigationManager Navigation

<PageTitle>
    @(_settlement is null
        ? _text.Settlement.PageTitle
        : TextTemplate.Format(_text.App.PageTitlePattern, ("page", _settlement.Name)))
</PageTitle>

<div class="settlement-tool">
    <h1>@_text.Settlement.Heading</h1>

    @if (_loadError is { } loadError)
    {
        <div class="notice">
            <strong>@_text.Settlement.LoadErrorHeading</strong>
            <p class="mb-0 mt-1">@loadError</p>
        </div>
    }
    else if (_generator is null)
    {
        <p>@_text.Settlement.Loading</p>
    }
    else
    {
        <p class="lead">@((MarkupString)_text.Settlement.LeadHtml)</p>

        <div class="generator-bar no-print">
            <div class="field">
                <label for="seed">@_text.Settlement.Controls.SeedLabel</label>
                <input id="seed" type="text" value="@_seedText" @onchange="OnSeedChanged" spellcheck="false" />
            </div>

            <div class="field">
                <label for="size">@_text.Settlement.Controls.SizeLabel</label>
                <select id="size" @onchange="OnSizeChanged">
                    <option value="" selected="@(_options.Size is null)">@_text.Settlement.Controls.SizeRollOption</option>
                    @foreach (SettlementSize size in _data!.Settlement.Sizes)
                    {
                        <option value="@size.SizeValue" selected="@(_options.Size == size.SizeValue)">
                            @size.Describe(_text.Grammar)
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label for="terrain">@_text.Settlement.Controls.TerrainLabel</label>
                <select id="terrain" @onchange="OnTerrainChanged">
                    <option value="" selected="@(_options.Terrain is null)">@_text.Settlement.Controls.TerrainAnyOption</option>
                    @for (int i = 0; i < TerrainValues.Length; i++)
                    {
                        string value = TerrainValues[i];
                        <option value="@value" selected="@(_options.Terrain == value)">@TerrainLabel(i)</option>
                    }
                </select>
            </div>

            <div class="field checkbox">
                <input id="human" type="checkbox" checked="@_options.NearHumanTown" @onchange="OnHumanTownChanged" />
                <label for="human" title="@_text.Settlement.Controls.NearHumanTitle">
                    @_text.Settlement.Controls.NearHumanLabel
                </label>
            </div>

            <div class="toolbar-actions">
                <button type="button" class="btn-ink" @onclick="RollNew">@_text.Settlement.Controls.RollNew</button>
                <button type="button" class="btn-quiet" @onclick="RerollUnlocked" disabled="@(!HasPins)">
                    @_text.Settlement.Controls.RerollUnlocked
                </button>
                <button type="button" class="btn-quiet" @onclick="CopyLink">@_text.Settlement.Controls.CopyLink</button>
                <button type="button" class="btn-quiet" @onclick="ExportJson">@_text.Settlement.Controls.ExportJson</button>
                <label class="btn-quiet mb-0" style="cursor:pointer">
                    @_text.Settlement.Controls.ImportJson
                    <InputFile OnChange="ImportJson" accept=".json,application/json" style="display:none" />
                </label>
                <button type="button" class="btn-quiet" @onclick="Print">@_text.Settlement.Controls.Print</button>
            </div>
        </div>

        <div class="status-line no-print" role="status" aria-live="polite">@_status</div>

        @if (_settlement is { } settlement)
        {
            <div class="sheet">
                <div class="sheet-title">
                    <h2>@settlement.Name</h2>
                    <span class="seed-tag">
                        @TextTemplate.Format(_text.Settlement.Sections.SeedTag, ("seed", SeedCodec.Encode(settlement.Seed)))
                    </span>
                </div>
                <p class="sheet-summary">@settlement.Summary</p>

                @if (_map is { } map)
                {
                    <h3 class="section-heading">
                        @_text.Settlement.Map.Heading
                        <span class="no-print">
                            <button type="button" class="icon-btn" title="@_text.Settlement.Map.RedrawTitle" @onclick="RerollMap">&#8635;</button>
                            <button type="button" class="icon-btn" title="@_text.Settlement.Map.DownloadTitle" @onclick="DownloadMap">&#8615;</button>
                        </span>
                    </h3>

                    <MapView Map="map" Svg="@_mapSvg" />
                }

                <h3 class="section-heading">@_text.Settlement.Sections.Settlement</h3>

                <FieldRow Label="@_text.Settlement.Labels.Name" Path="settlement/name"
                          Values="@(new[] { settlement.Name })"
                          IsLocked="@IsLocked("settlement/name")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@_text.Settlement.Labels.Size" Path="settlement/size"
                          Values="@(new[] { settlement.Size.Describe(_text.Grammar) })"
                          IsLocked="@IsLocked("settlement/size")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@_text.Settlement.Labels.Built" Path="settlement/host"
                          Values="@(new[] { BuiltValue(settlement) })"
                          IsLocked="@IsLocked("settlement/host")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@_text.Settlement.Labels.Governance" Path="settlement/governance"
                          Values="@(new[] { GovernanceValue(settlement) })"
                          IsLocked="@IsLocked("settlement/governance")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@_text.Settlement.Labels.Inhabitants" Path="settlement/inhabitants"
                          Values="@(new[] { settlement.Inhabitants })"
                          IsLocked="@IsLocked("settlement/inhabitants")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@(settlement.NotableFeatures.Count > 1 ? _text.Settlement.Labels.Features : _text.Settlement.Labels.Feature)"
                          Path="settlement/features"
                          Values="settlement.NotableFeatures"
                          IsLocked="@IsLocked("settlement/features")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@(settlement.Industries.Count > 1 ? _text.Settlement.Labels.Industries : _text.Settlement.Labels.Industry)"
                          Path="settlement/industries"
                          Values="settlement.Industries"
                          IsLocked="@IsLocked("settlement/industries")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                <FieldRow Label="@_text.Settlement.Labels.RightNow" Path="settlement/event"
                          Values="@(new[] { settlement.Event })"
                          IsLocked="@IsLocked("settlement/event")"
                          OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                @if (settlement.Tavern is { } tavern)
                {
                    <h3 class="section-heading">@_text.Settlement.Sections.Tavern</h3>

                    <FieldRow Label="@_text.Settlement.Labels.Sign" Path="tavern/name"
                              Values="@(new[] { tavern.Name })"
                              IsLocked="@IsLocked("tavern/name")"
                              OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                    <FieldRow Label="@_text.Settlement.Labels.Specialty" Path="tavern/meal"
                              Values="@(new[] { tavern.SpecialtyMeal })"
                              IsLocked="@IsLocked("tavern/meal")"
                              OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />

                    <FieldRow Label="@_text.Settlement.Labels.Landlord" Path="tavern/keeper/name"
                              Values="@(new[] { KeeperValue(tavern.Keeper) })"
                              IsLocked="@IsLocked("tavern/keeper/name")"
                              OnToggleLock="ToggleLock" OnReroll="Reroll" OnEdit="Edit" />
                }

                <h3 class="section-heading">
                    @_text.Settlement.Sections.Shops
                    <span class="house-rule-tag" title="@_text.Settlement.Sections.HouseRuleTitle">
                        @_text.Settlement.Sections.HouseRuleTag
                    </span>
                </h3>

                @if (settlement.Shops.Count == 0)
                {
                    <p class="notice subtle mb-0">@_text.Settlement.Sections.NoShops</p>
                }
                else
                {
                    <div class="shop-grid">
                        @foreach (Shop shop in settlement.Shops)
                        {
                            <ShopView Shop="shop"
                                      PipAbbreviation="@_data!.Gear.Currency.Abbreviation"
                                      Culture="_data!.Locale.FormatCulture" />
                        }
                    </div>

                    @if (CardableStock.Count > 0)
                    {
                        <h3 class="section-heading page-break">@_text.Settlement.Sections.ItemCards</h3>
                        <p class="price-note">@_text.Settlement.Sections.ItemCardsNote</p>
                        <div class="card-sheet">
                            @foreach (StockEntry entry in CardableStock)
                            {
                                @* CategoryId is a string parameter, so it needs @ to be treated as
                                   an expression rather than a literal. *@
                                <ItemCardView Entry="entry" CategoryId="@entry.CategoryId" />
                            }
                        </div>
                    }
                }
            </div>
        }

        <div class="notice subtle no-print">
            <strong>@_text.Settlement.Sections.OfficialNoticeHeading</strong>
            @((MarkupString)_text.Settlement.Sections.OfficialNoticeHtml)
        </div>
    }

    <LicenceFooter />
</div>

@code {
    private const string StorageKey = "mausritter-tools.settlement";

    /// <summary>
    /// Terrain keys, matched against the host tables. These are identifiers, not labels, and are
    /// never translated; their display names come from the loaded text, in this order.
    /// </summary>
    private static readonly string[] TerrainValues = ["countryside", "forest", "river", "human-town"];

    private GameData? _data;
    private UiText _text = new();
    private SettlementGenerator? _generator;
    private Settlement? _settlement;
    private SettlementMap? _map;
    private string _mapSvg = "";
    private GenerationOptions _options = new();
    private string _seedText = "";
    private string _status = "";
    private string? _loadError;
    private bool _restoring;

    private bool HasPins => _options.Pins.Count > 0;

    private string TerrainLabel(int index) =>
        index < _text.Settlement.Controls.TerrainOptions.Count
            ? _text.Settlement.Controls.TerrainOptions[index]
            : TerrainValues[index];

    private string BuiltValue(Settlement settlement) => TextTemplate.Format(
        _text.Settlement.Labels.BuiltValue,
        ("host", Capitalise(settlement.Host.Describe())),
        ("description", settlement.Host.Description));

    private string GovernanceValue(Settlement settlement) => TextTemplate.Format(
        _text.Settlement.Labels.GovernanceValue,
        ("governance", settlement.Governance),
        ("roll", settlement.GovernanceRoll.ToString()));

    private string KeeperValue(MouseNpc keeper) => TextTemplate.Format(
        _text.Settlement.Labels.KeeperValue,
        ("name", keeper.FullName),
        ("appearance", keeper.Appearance),
        ("quirk", keeper.Quirk),
        ("wants", keeper.Wants));

    private IReadOnlyList<StockEntry> CardableStock =>
        _settlement is null
            ? []
            : [.. _settlement.Shops
                .Where(shop => !shop.Service.ServiceOnly)
                .SelectMany(shop => shop.Stock)
                .Where(entry => ItemCard.IsCardable(entry.Item))];

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Languages.Changed += OnLanguageChanged;

        if (!await LoadDataAsync())
        {
            return;
        }

        await RestoreStateAsync();
    }

    private async Task<bool> LoadDataAsync()
    {
        try
        {
            _data = await DataProvider.GetDataAsync();
            _text = _data.Text;
            _generator = await DataProvider.GetGeneratorAsync();

            return true;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            return false;
        }
    }

    /// <summary>
    /// Rebuilds the sheet in the newly chosen language.
    /// </summary>
    /// <remarks>
    /// The seed and every lock are kept. Tables are translated row for row, so the same seed lands
    /// on the same rows and this is genuinely the same settlement, re-read rather than re-rolled.
    /// </remarks>
    private async Task OnLanguageChanged()
    {
        _loadError = null;

        if (!await LoadDataAsync())
        {
            StateHasChanged();
            return;
        }

        Regenerate(updateUrl: true);
        _status = TextTemplate.Format(
            _text.Settlement.Status.LanguageChanged, ("language", Languages.Current.NativeName));

        StateHasChanged();
    }

    /// <summary>
    /// Restores the last settlement, from the URL or from the autosave.
    /// </summary>
    /// <remarks>
    /// The saved state is preferred when it is the same settlement the URL names, because only the
    /// autosave carries the locks, hand edits and map redraws; the URL holds the seed and settings
    /// alone. A link to a <em>different</em> settlement still wins, so following a shared link
    /// shows that settlement rather than whatever was last worked on.
    /// </remarks>
    private async Task RestoreStateAsync()
    {
        bool hasUrlOptions = TryReadOptionsFromUrl(out GenerationOptions fromUrl);
        GenerationOptions? saved = await ReadSavedOptionsAsync();

        if (hasUrlOptions)
        {
            bool savedIsSameSettlement =
                saved is not null &&
                saved.Seed == fromUrl.Seed &&
                saved.Size == fromUrl.Size &&
                saved.NearHumanTown == fromUrl.NearHumanTown &&
                saved.Terrain == fromUrl.Terrain;

            _options = savedIsSameSettlement ? saved! : fromUrl;
            Regenerate(updateUrl: false);
            return;
        }

        if (saved is not null)
        {
            _options = saved;
            Regenerate(updateUrl: true);
            return;
        }

        _options = new GenerationOptions { Seed = SeedCodec.CreateRandom() };
        Regenerate(updateUrl: true);
    }

    private async Task<GenerationOptions?> ReadSavedOptionsAsync()
    {
        string? saved = await Browser.ReadStorageAsync(StorageKey);
        if (saved is not { Length: > 0 })
        {
            return null;
        }

        try
        {
            return SettlementSerializer.FromJson(saved);
        }
        catch (SettlementFormatException)
        {
            // Written by an older or newer build; discard rather than fail to load the page.
            await Browser.ClearStorageAsync(StorageKey);
            return null;
        }
    }

    private bool TryReadOptionsFromUrl(out GenerationOptions options)
    {
        options = new GenerationOptions();

        Uri uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        Dictionary<string, string> query = ParseQuery(uri.Query);

        if (!query.TryGetValue("s", out string? seedText) ||
            !SeedCodec.TryDecode(seedText, out uint seed))
        {
            return false;
        }

        options = new GenerationOptions
        {
            Seed = seed,
            Size = query.TryGetValue("size", out string? sizeText) && int.TryParse(sizeText, out int size)
                ? size
                : null,
            NearHumanTown = query.TryGetValue("human", out string? human) && human == "1",
            Terrain = query.TryGetValue("terrain", out string? terrain) && terrain.Length > 0
                ? terrain
                : null
        };

        return true;
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        Dictionary<string, string> parsed = new(StringComparer.OrdinalIgnoreCase);

        foreach (string pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            string[] parts = pair.Split('=', 2);
            parsed[Uri.UnescapeDataString(parts[0])] =
                parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
        }

        return parsed;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_restoring || _generator is null)
        {
            return;
        }

        if (TryReadOptionsFromUrl(out GenerationOptions fromUrl) && fromUrl.Seed != _options.Seed)
        {
            _options = fromUrl;
            Regenerate(updateUrl: false);
            StateHasChanged();
        }
    }

    private void Regenerate(bool updateUrl)
    {
        if (_generator is null)
        {
            return;
        }

        _settlement = _generator.Generate(_options);
        _seedText = SeedCodec.Encode(_options.Seed);

        _map = MapGenerator.Generate(_settlement, MapSeed, _text.Grammar);
        _mapSvg = SvgMapRenderer.Render(_map, MapSeed, _text.Settlement.Map.AriaLabel);

        if (updateUrl)
        {
            UpdateUrl();
        }

        _ = SaveStateAsync();
    }

    /// <summary>
    /// The seed the map is drawn from.
    /// </summary>
    /// <remarks>
    /// Derived from the settlement's seed so a shared link reproduces the same map, but shifted by
    /// how many times the map alone has been re-drawn, so the layout can be changed without
    /// disturbing a settlement the user is happy with.
    /// </remarks>
    private uint MapSeed =>
        _options.Rerolls.TryGetValue("map", out int redraws) && redraws > 0
            ? (uint)SeedDerivation.Derive(_options.Seed, $"map#{redraws}")
            : _options.Seed;

    private void RerollMap()
    {
        _options = _options.WithReroll("map");
        Regenerate(updateUrl: false);
        _status = _text.Settlement.Status.MapRedrawn;
    }

    private async Task DownloadMap()
    {
        if (_settlement is not { } settlement || _mapSvg.Length == 0)
        {
            return;
        }

        string fileName = System.IO.Path.ChangeExtension(
            SettlementSerializer.SuggestFileName(settlement), ".svg");

        await Browser.DownloadTextAsync(fileName, "image/svg+xml", _mapSvg);
        _status = _text.Settlement.Status.MapDownloaded;
    }

    /// <summary>
    /// Keeps the address bar in step with the settings. Only the settings and the language go in
    /// the URL; locks and hand edits would make it unwieldy, so those live in the autosave and the
    /// JSON export.
    /// </summary>
    private void UpdateUrl()
    {
        StringBuilder query = new($"?s={SeedCodec.Encode(_options.Seed)}");

        if (_options.Size is { } size)
        {
            query.Append($"&size={size}");
        }

        if (_options.NearHumanTown)
        {
            query.Append("&human=1");
        }

        if (_options.Terrain is { Length: > 0 } terrain)
        {
            query.Append($"&terrain={Uri.EscapeDataString(terrain)}");
        }

        // Carried so a settlement written up in German opens in German for whoever it is sent to.
        if (!Languages.Current.IsCanonical)
        {
            query.Append($"&{LocaleState.QueryParameter}={Languages.Current.Code}");
        }

        _restoring = true;
        Navigation.NavigateTo($"settlement{query}", forceLoad: false, replace: true);
        _restoring = false;
    }

    private async Task SaveStateAsync()
    {
        if (_settlement is null)
        {
            return;
        }

        await Browser.WriteStorageAsync(
            StorageKey,
            SettlementSerializer.ToJson(_settlement, _options, locale: Languages.Current.Code));
    }

    private void RollNew()
    {
        // A fresh seed re-rolls everything except the values the user has locked.
        _options = _options with { Seed = SeedCodec.CreateRandom(), Rerolls = new Dictionary<string, int>() };
        Regenerate(updateUrl: true);
        _status = HasPins ? _text.Settlement.Status.RolledNewKeepingLocks : "";
    }

    private void RerollUnlocked()
    {
        _options = _options with { Seed = SeedCodec.CreateRandom(), Rerolls = new Dictionary<string, int>() };
        Regenerate(updateUrl: true);

        _status = _options.Pins.Count == 1
            ? _text.Settlement.Status.RerolledExceptOne
            : TextTemplate.Format(
                _text.Settlement.Status.RerolledExceptMany,
                ("count", _options.Pins.Count.ToString()));
    }

    private void OnSeedChanged(ChangeEventArgs args)
    {
        string text = args.Value?.ToString() ?? "";

        if (!SeedCodec.TryDecode(text, out uint seed))
        {
            _status = TextTemplate.Format(_text.Settlement.Status.InvalidSeed, ("seed", text));
            _seedText = SeedCodec.Encode(_options.Seed);
            return;
        }

        _options = _options with { Seed = seed };
        Regenerate(updateUrl: true);
        _status = "";
    }

    private void OnSizeChanged(ChangeEventArgs args)
    {
        string text = args.Value?.ToString() ?? "";

        _options = _options with { Size = int.TryParse(text, out int size) ? size : null };

        // The size drives which services are legal, so a stale pinned size would contradict it.
        _options = _options.WithoutPin("settlement/size");

        Regenerate(updateUrl: true);
    }

    private void OnTerrainChanged(ChangeEventArgs args)
    {
        string text = args.Value?.ToString() ?? "";

        _options = (_options with { Terrain = text.Length > 0 ? text : null })
            .WithoutPin("settlement/host");

        Regenerate(updateUrl: true);
    }

    private void OnHumanTownChanged(ChangeEventArgs args)
    {
        _options = _options with { NearHumanTown = args.Value is true };
        Regenerate(updateUrl: true);
    }

    private bool IsLocked(string path) => _options.IsPinned(path);

    private void ToggleLock(string path)
    {
        if (_options.IsPinned(path))
        {
            _options = _options.WithoutPin(path);
            _status = _text.Settlement.Status.Unlocked;
        }
        else
        {
            // Locking freezes the value as it stands, so it survives any later re-roll. The
            // generator records what to store, which for a table entry is its position rather than
            // its words, so the lock still means the same thing after a change of language.
            _options = _options.WithPin(path, _settlement?.PinValues.GetValueOrDefault(path) ?? "");
            _status = _text.Settlement.Status.Locked;
        }

        Regenerate(updateUrl: false);
    }

    private void Reroll(string path)
    {
        _options = _options.WithReroll(path);
        Regenerate(updateUrl: false);
        _status = "";
    }

    private void Edit((string Path, string Value) edit)
    {
        // Stored verbatim: these are the user's own words, and no table row can stand in for them.
        _options = _options.WithPin(edit.Path, edit.Value);
        Regenerate(updateUrl: false);
        _status = _text.Settlement.Status.Edited;
    }

    private async Task CopyLink()
    {
        bool copied = await Browser.CopyTextAsync(Navigation.Uri);
        _status = copied
            ? _text.Settlement.Status.LinkCopied
            : _text.Settlement.Status.ClipboardFailed;
    }

    private async Task ExportJson()
    {
        if (_settlement is not { } settlement)
        {
            return;
        }

        await Browser.DownloadTextAsync(
            SettlementSerializer.SuggestFileName(settlement),
            "application/json",
            SettlementSerializer.ToJson(settlement, _options, locale: Languages.Current.Code));

        _status = _text.Settlement.Status.Exported;
    }

    private async Task ImportJson(InputFileChangeEventArgs args)
    {
        try
        {
            // Generous but bounded: an exported settlement is a few tens of kilobytes.
            await using Stream stream = args.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using StreamReader reader = new(stream);

            SettlementImport imported = SettlementSerializer.Read(await reader.ReadToEndAsync());
            _options = imported.Options;

            // Shown as its author saw it, which also keeps any locked table entries reading in the
            // language they were locked in.
            if (imported.Locale is { Length: > 0 } code)
            {
                await Languages.SetAsync(Locale.FromCode(code));
            }

            Regenerate(updateUrl: true);
            _status = TextTemplate.Format(
                _text.Settlement.Status.Imported, ("file", args.File.Name));
        }
        catch (SettlementFormatException ex)
        {
            _status = TextTemplate.Format(
                _text.Settlement.Status.ImportFailed, ("message", ex.Message));
        }
        catch (IOException ex)
        {
            _status = TextTemplate.Format(
                _text.Settlement.Status.ReadFailed, ("message", ex.Message));
        }
    }

    private async Task Print() => await Browser.PrintAsync();

    private static string Capitalise(string value) =>
        value.Length == 0 ? value : char.ToUpperInvariant(value[0]) + value[1..];

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Languages.Changed -= OnLanguageChanged;
    }
}
