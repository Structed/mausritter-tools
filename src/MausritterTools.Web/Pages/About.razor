@page "/about"
@using MausritterTools.Core.Data
@using MausritterTools.Web.Components
@using MausritterTools.Web.Services
@inject GameDataProvider DataProvider

<PageTitle>@TextTemplate.Format(Text.App.PageTitlePattern, ("page", Text.About.Heading))</PageTitle>

<div class="settlement-tool">
    <h1>@Text.About.Heading</h1>

    <p class="lead">@((MarkupString)Text.About.LeadHtml)</p>

    <AboutSectionView Section="Text.About.HowItWorks" />
    <AboutSectionView Section="Text.About.Official" />
    <AboutSectionView Section="Text.About.Translation" />

    @if (_provenance is { Count: > 0 })
    {
        <h2>@Text.About.DataSources.Heading</h2>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Text.About.DataSources.ContentColumn</th>
                    <th>@Text.About.DataSources.SourceColumn</th>
                    <th>@Text.About.DataSources.LicenceColumn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataProvenance source in _provenance)
                {
                    <tr>
                        <td>@source.Describes</td>
                        <td>
                            @if (source.IsSrdDerived)
                            {
                                <a href="@source.Url" target="_blank" rel="noopener">@source.Work</a>
                                @(source.Version is { Length: > 0 } v ? $" v{v}" : "")
                            }
                            else
                            {
                                <text>@Text.About.DataSources.OriginalSource</text>
                            }
                        </td>
                        <td>@(source.Licence ?? Text.About.DataSources.OriginalLicence)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <AboutSectionView Section="Text.About.Source" />
    <AboutSectionView Section="Text.About.Support" />

    <LicenceFooter />
</div>

@code {
    private IReadOnlyList<DataProvenance>? _provenance;

    [CascadingParameter]
    private UiText Text { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            GameData data = await DataProvider.GetDataAsync();
            _provenance = data.Provenance;
        }
        catch (GameDataException)
        {
            // The attribution above is static, so the page is still worth showing without the
            // per-file table.
            _provenance = null;
        }
    }
}
