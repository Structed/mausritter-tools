@using MausritterTools.Core.Data

@* Both licence notices. The Mausritter Third Party Licence requires its text to appear on the
   website where the work is promoted, not only inside the repository.

   Rendered once by MainLayout, so there is no per-page switch: the house-rule note is a statement
   about this tool rather than about one of its pages, and the alternative is a page that quietly
   ships without a notice it needed. *@

<footer class="site-footer">
    <p>@((MarkupString)Text.Licence.BasedOnHtml)</p>
    <p>@((MarkupString)Text.Licence.IndependentHtml)</p>
    <p>@((MarkupString)Text.Licence.CopyrightHtml)</p>
    <p>@Text.Licence.HouseRuleNote</p>

    @* Present only in a translation: CC BY 4.0 requires a modification to be declared, and a
       translation is one. *@
    @if (Text.Licence.TranslationNote is { Length: > 0 } translationNote)
    {
        <p>@translationNote</p>
    }
</footer>

@code {
    [CascadingParameter]
    private UiText Text { get; set; } = new();
}
