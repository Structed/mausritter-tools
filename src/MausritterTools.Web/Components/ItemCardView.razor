@using MausritterTools.Core.Data
@using MausritterTools.Core.Model

@* A Mausritter-style item card. Card templates and art are explicitly reusable under the
   Mausritter Third Party Licence. *@

<div class="item-card @(Shape == CardShape.Wide ? "wide" : null)">
    <div class="item-name">@Entry.Item.DisplayLabel</div>

    @if (Entry.Item.Qualifier is { Length: > 0 } qualifier)
    {
        <div class="item-type">@qualifier</div>
    }
    else if (TypeLabel is { Length: > 0 })
    {
        <div class="item-type">@TypeLabel</div>
    }

    @if (Entry.Item.Note is { Length: > 0 } note)
    {
        <div class="item-note">@note</div>
    }

    <div class="item-foot">
        <span class="item-price">@Entry.PriceText</span>

        @if (UsageDots > 0)
        {
            <span class="usage-dots" title="@TextTemplate.Format(Text.ItemCard.UsageDotsTitle, ("count", UsageDots.ToString()))">
                @for (int i = 0; i < UsageDots; i++)
                {
                    <span></span>
                }
            </span>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private UiText Text { get; set; } = new();

    [Parameter, EditorRequired]
    public StockEntry Entry { get; set; } = new();

    /// <summary>The gear category the item came from, which determines whether it has usage.</summary>
    [Parameter]
    public string? CategoryId { get; set; }

    /// <summary>Shown when the item has no qualifier of its own, e.g. the shop type.</summary>
    [Parameter]
    public string? TypeLabel { get; set; }

    private CardShape Shape => ItemCard.ShapeFor(Entry.Item);

    private int UsageDots => ItemCard.UsageDotsFor(Entry.Item, CategoryId);
}
