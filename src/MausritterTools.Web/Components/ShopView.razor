@using System.Globalization
@using MausritterTools.Core.Data
@using MausritterTools.Core.Model

@* One shop: sign, type, quirk, proprietor and stock. *@

<article class="shop">
    <header class="shop-head">
        <span class="shop-number" title="@TextTemplate.Format(Text.Shop.MapKeyTitle, ("index", Shop.Index.ToString()))">@Shop.Index</span>
        <span class="shop-name">@Shop.SignName</span>
        <span class="shop-type">@Shop.Service.Name</span>
    </header>

    <p class="mb-2">@Shop.Service.Blurb</p>

    <dl>
        <dt>@Text.Shop.Quirk</dt>
        <dd>@Shop.Quirk</dd>
    </dl>

    <div class="keeper">
        <div class="keeper-name">@Shop.Keeper.FullName</div>
        <div>@Shop.Keeper.Appearance. @Shop.Keeper.Quirk.</div>
        <div class="keeper-meta">@KeeperMeta</div>
        <div class="keeper-meta">@TextTemplate.Format(Text.Shop.Wants, ("wants", Shop.Keeper.Wants))</div>
        @if (Shop.Keeper.RelationshipSummary is { } relationship)
        {
            <div class="keeper-meta">@relationship</div>
        }
    </div>

    @if (Shop.Service.ServiceTerms is { } terms)
    {
        <dl>
            <dt>@Text.Shop.Terms</dt>
            <dd>@terms</dd>
        </dl>
    }

    @if (Shop.Service.OffersRepairs)
    {
        <dl>
            <dt>@Text.Shop.Repairs</dt>
            <dd>@Text.Shop.RepairsText</dd>
        </dl>
    }

    @if (Shop.Service.BuysSpells)
    {
        <dl>
            <dt>@Text.Shop.Spells</dt>
            <dd>@Text.Shop.SpellsText</dd>
        </dl>
    }

    @if (Shop.Stock.Count > 0)
    {
        <table class="stock-table">
            <thead>
                <tr>
                    <th>@(Shop.Service.OffersHirelings ? Text.Shop.LookingForWork : Text.Shop.InStock)</th>
                    <th class="qty">@(Shop.Service.OffersHirelings ? Text.Shop.Number : Text.Shop.Quantity)</th>
                    <th class="price">@(Shop.Service.OffersHirelings ? Text.Shop.PerDay : Text.Shop.Price)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (StockEntry entry in Shop.Stock)
                {
                    <tr>
                        <td>
                            @entry.DisplayName
                            @if (entry.Item.Note is { Length: > 0 } note)
                            {
                                <span class="price-note"> (@note)</span>
                            }
                        </td>
                        <td class="qty">@(entry.Quantity?.ToString() ?? "—")</td>
                        <td class="price">@entry.PriceText</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Shop.PriceAdjustmentPercent != 0)
        {
            <p class="price-note mt-1">@PriceNote</p>
        }
    }

    <details class="mt-2">
        <summary class="price-note">@Text.Shop.WhereThisComesFrom</summary>
        <p class="price-note mt-1 mb-0">@Shop.Service.SrdBasis</p>
    </details>
</article>

@code {
    [CascadingParameter]
    private UiText Text { get; set; } = new();

    [Parameter, EditorRequired]
    public Shop Shop { get; set; } = new();

    /// <summary>The pip abbreviation, so a purse reads "340p" in any language.</summary>
    [Parameter]
    public string PipAbbreviation { get; set; } = "p";

    /// <summary>
    /// The language the purse is formatted for: "1,000p" in English, "1.000 P" in German.
    /// </summary>
    /// <remarks>
    /// Passed in and applied explicitly rather than read from the ambient culture, which this app
    /// deliberately never changes. See <c>LocaleState</c> for why.
    /// </remarks>
    [Parameter]
    public CultureInfo Culture { get; set; } = CultureInfo.InvariantCulture;

    private string KeeperMeta => TextTemplate.Format(
        Text.Shop.KeeperMeta,
        ("position", Shop.Keeper.Position.Name),
        ("purse", Shop.Keeper.Purse.ToString("N0", Culture) + PipAbbreviation),
        ("birthsign", Shop.Keeper.Birthsign.Name),
        ("disposition", Shop.Keeper.Disposition));

    private string PriceNote => TextTemplate.Format(
        Shop.PriceAdjustmentPercent > 0 ? Text.Shop.PriceAbove : Text.Shop.PriceBelow,
        ("percent", Math.Abs(Shop.PriceAdjustmentPercent).ToString(CultureInfo.InvariantCulture)));
}
